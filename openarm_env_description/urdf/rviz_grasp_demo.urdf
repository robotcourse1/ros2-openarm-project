<?xml version="1.0"?>
<robot name="openarm_grasp_demo">
  
  <!-- ==================== World ==================== -->
  <link name="world"/>
  
  <!-- ==================== 桌子 ==================== -->
  <link name="table">
    <visual>
      <origin xyz="0 0 0.375" rpy="0 0 0"/>
      <geometry>
        <box size="1.0 0.6 0.75"/>
      </geometry>
      <material name="wood">
        <color rgba="0.6 0.4 0.2 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.375" rpy="0 0 0"/>
      <geometry>
        <box size="1.0 0.6 0.75"/>
      </geometry>
    </collision>
  </link>
  
  <joint name="table_fixed" type="fixed">
    <parent link="world"/>
    <child link="table"/>
    <origin xyz="0.8 0.0 0.0" rpy="0 0 0"/>
  </joint>
  
  <!-- ==================== 苹果（目标物体） ==================== -->
  <link name="apple">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.04"/>
      </geometry>
      <material name="red">
        <color rgba="0.9 0.1 0.1 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <sphere radius="0.04"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.15"/>
      <inertia ixx="1e-4" ixy="0" ixz="0" iyy="1e-4" iyz="0" izz="1e-4"/>
    </inertial>
  </link>
  
  <joint name="apple_fixed" type="fixed">
    <parent link="table"/>
    <child link="apple"/>
    <origin xyz="0.05 -0.15 0.79" rpy="0 0 0"/>
  </joint>
  
  <!-- ==================== 机器人底座 ==================== -->
  <link name="robot_base">
    <visual>
      <origin xyz="0 0 0.175" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.15" length="0.35"/>
      </geometry>
      <material name="dark_gray">
        <color rgba="0.3 0.3 0.3 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.175" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.15" length="0.35"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="5.0"/>
      <inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1"/>
    </inertial>
  </link>
  
  <joint name="robot_base_fixed" type="fixed">
    <parent link="world"/>
    <child link="robot_base"/>
    <origin xyz="0.8 -0.45 0.35" rpy="0 0 1.5708"/>
  </joint>
  
  <!-- ==================== 机器人躯干 ==================== -->
  <link name="robot_body">
    <visual>
      <origin xyz="0 0 0.2" rpy="0 0 0"/>
      <geometry>
        <box size="0.2 0.3 0.4"/>
      </geometry>
      <material name="white">
        <color rgba="0.95 0.95 0.95 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.2" rpy="0 0 0"/>
      <geometry>
        <box size="0.2 0.3 0.4"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="3.0"/>
      <inertia ixx="0.05" ixy="0" ixz="0" iyy="0.05" iyz="0" izz="0.05"/>
    </inertial>
  </link>
  
  <joint name="body_joint" type="fixed">
    <parent link="robot_base"/>
    <child link="robot_body"/>
    <origin xyz="0 0 0.35" rpy="0 0 0"/>
  </joint>
  
  <!-- ==================== 右臂肩部连接 ==================== -->
  <link name="right_shoulder_link">
    <visual>
      <geometry>
        <sphere radius="0.04"/>
      </geometry>
      <material name="light_gray">
        <color rgba="0.7 0.7 0.7 1"/>
      </material>
    </visual>
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>
  
  <joint name="right_shoulder_fixed" type="fixed">
    <parent link="robot_body"/>
    <child link="right_shoulder_link"/>
    <origin xyz="0 -0.031 0.35" rpy="1.5708 0 0"/>
  </joint>
  
  <!-- ==================== 右臂 Joint1 - 肩部旋转 ==================== -->
  <link name="right_link1">
    <visual>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.035" length="0.06"/>
      </geometry>
      <material name="blue">
        <color rgba="0.2 0.4 0.8 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.035" length="0.06"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.8"/>
      <inertia ixx="0.002" ixy="0" ixz="0" iyy="0.002" iyz="0" izz="0.001"/>
    </inertial>
  </link>
  
  <joint name="right_joint1" type="revolute">
    <parent link="right_shoulder_link"/>
    <child link="right_link1"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.396" upper="3.49" effort="50" velocity="2.0"/>
  </joint>
  
  <!-- ==================== 右臂 Joint2 - 大臂前倾 ==================== -->
  <link name="right_link2">
    <visual>
      <origin xyz="0.08 0 0" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder radius="0.03" length="0.16"/>
      </geometry>
      <material name="white"/>
    </visual>
    <collision>
      <origin xyz="0.08 0 0" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder radius="0.03" length="0.16"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.6"/>
      <origin xyz="0.08 0 0"/>
      <inertia ixx="0.002" ixy="0" ixz="0" iyy="0.002" iyz="0" izz="0.001"/>
    </inertial>
  </link>
  
  <joint name="right_joint2" type="revolute">
    <parent link="right_link1"/>
    <child link="right_link2"/>
    <origin xyz="0 0 0.06" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.175" upper="3.316" effort="50" velocity="2.0"/>
  </joint>
  
  <!-- ==================== 右臂 Joint3 - 大臂旋转 ==================== -->
  <link name="right_link3">
    <visual>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.028" length="0.04"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.028" length="0.04"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.4"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.0005"/>
    </inertial>
  </link>
  
  <joint name="right_joint3" type="revolute">
    <parent link="right_link2"/>
    <child link="right_link3"/>
    <origin xyz="0.16 0 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-1.571" upper="1.571" effort="30" velocity="2.0"/>
  </joint>
  
  <!-- ==================== 右臂 Joint4 - 肘部弯曲 ==================== -->
  <link name="right_link4">
    <visual>
      <origin xyz="0.07 0 0" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder radius="0.025" length="0.14"/>
      </geometry>
      <material name="white"/>
    </visual>
    <collision>
      <origin xyz="0.07 0 0" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder radius="0.025" length="0.14"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.5"/>
      <origin xyz="0.07 0 0"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.0005"/>
    </inertial>
  </link>
  
  <joint name="right_joint4" type="revolute">
    <parent link="right_link3"/>
    <child link="right_link4"/>
    <origin xyz="0 0 0.04" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0.0" upper="2.443" effort="30" velocity="2.0"/>
  </joint>
  
  <!-- ==================== 右臂 Joint5 - 前臂旋转 ==================== -->
  <link name="right_link5">
    <visual>
      <origin xyz="0 0 0.015" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.022" length="0.03"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.015" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.022" length="0.03"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.3"/>
      <inertia ixx="0.0005" ixy="0" ixz="0" iyy="0.0005" iyz="0" izz="0.0003"/>
    </inertial>
  </link>
  
  <joint name="right_joint5" type="revolute">
    <parent link="right_link4"/>
    <child link="right_link5"/>
    <origin xyz="0.14 0 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-1.571" upper="1.571" effort="20" velocity="2.0"/>
  </joint>
  
  <!-- ==================== 右臂 Joint6 - 腕部俯仰 ==================== -->
  <link name="right_link6">
    <visual>
      <origin xyz="0.03 0 0" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder radius="0.02" length="0.06"/>
      </geometry>
      <material name="white"/>
    </visual>
    <collision>
      <origin xyz="0.03 0 0" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder radius="0.02" length="0.06"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.2"/>
      <origin xyz="0.03 0 0"/>
      <inertia ixx="0.0003" ixy="0" ixz="0" iyy="0.0003" iyz="0" izz="0.0002"/>
    </inertial>
  </link>
  
  <joint name="right_joint6" type="revolute">
    <parent link="right_link5"/>
    <child link="right_link6"/>
    <origin xyz="0 0 0.03" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.785" upper="0.785" effort="10" velocity="2.0"/>
  </joint>
  
  <!-- ==================== 右臂 Joint7 - 腕部旋转 ==================== -->
  <link name="right_link7">
    <visual>
      <origin xyz="0 0 0.01" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.018" length="0.02"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.01" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.018" length="0.02"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.15"/>
      <inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.0001"/>
    </inertial>
  </link>
  
  <joint name="right_joint7" type="revolute">
    <parent link="right_link6"/>
    <child link="right_link7"/>
    <origin xyz="0.06 0 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-1.571" upper="1.571" effort="10" velocity="2.0"/>
  </joint>
  
  <!-- ==================== 夹爪基座 ==================== -->
  <link name="right_gripper_base">
    <visual>
      <origin xyz="0.02 0 0" rpy="0 1.5708 0"/>
      <geometry>
        <box size="0.04 0.06 0.02"/>
      </geometry>
      <material name="dark_gray"/>
    </visual>
    <collision>
      <origin xyz="0.02 0 0" rpy="0 1.5708 0"/>
      <geometry>
        <box size="0.04 0.06 0.02"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>
  
  <joint name="right_gripper_base_joint" type="fixed">
    <parent link="right_link7"/>
    <child link="right_gripper_base"/>
    <origin xyz="0 0 0.02" rpy="0 0 0"/>
  </joint>
  
  <!-- ==================== 左夹爪手指 ==================== -->
  <link name="right_gripper_left_finger">
    <visual>
      <origin xyz="0.03 0 0" rpy="0 1.5708 0"/>
      <geometry>
        <box size="0.06 0.015 0.01"/>
      </geometry>
      <material name="light_gray"/>
    </visual>
    <collision>
      <origin xyz="0.03 0 0" rpy="0 1.5708 0"/>
      <geometry>
        <box size="0.06 0.015 0.01"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.00005" ixy="0" ixz="0" iyy="0.00005" iyz="0" izz="0.00005"/>
    </inertial>
  </link>
  
  <joint name="right_gripper_left_joint" type="prismatic">
    <parent link="right_gripper_base"/>
    <child link="right_gripper_left_finger"/>
    <origin xyz="0.04 0.025 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.025" upper="0.0" effort="10" velocity="0.5"/>
  </joint>
  
  <!-- ==================== 右夹爪手指 ==================== -->
  <link name="right_gripper_right_finger">
    <visual>
      <origin xyz="0.03 0 0" rpy="0 1.5708 0"/>
      <geometry>
        <box size="0.06 0.015 0.01"/>
      </geometry>
      <material name="light_gray"/>
    </visual>
    <collision>
      <origin xyz="0.03 0 0" rpy="0 1.5708 0"/>
      <geometry>
        <box size="0.06 0.015 0.01"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.00005" ixy="0" ixz="0" iyy="0.00005" iyz="0" izz="0.00005"/>
    </inertial>
  </link>
  
  <joint name="right_gripper_right_joint" type="prismatic">
    <parent link="right_gripper_base"/>
    <child link="right_gripper_right_finger"/>
    <origin xyz="0.04 -0.025 0" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="-0.025" upper="0.0" effort="10" velocity="0.5"/>
  </joint>
  
  <!-- ==================== 末端执行器参考点 ==================== -->
  <link name="right_ee_link">
    <visual>
      <geometry>
        <sphere radius="0.01"/>
      </geometry>
      <material name="green">
        <color rgba="0.1 0.9 0.1 1"/>
      </material>
    </visual>
  </link>
  
  <joint name="right_ee_joint" type="fixed">
    <parent link="right_gripper_base"/>
    <child link="right_ee_link"/>
    <origin xyz="0.08 0 0" rpy="0 0 0"/>
  </joint>

</robot>
